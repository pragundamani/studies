<svg xmlns="http://www.w3.org/2000/svg" width="720" height="260" viewBox="0 0 720 260"><style>text{font-family:Arial,sans-serif;font-size:18px;font-weight:600;fill:#111827} .wire{stroke:#0066ff;stroke-width:4;fill:none} .res{stroke:#ff7800;stroke-width:4;fill:#fff200} .src{stroke:#e6007e;stroke-width:4;fill:#ffb3e1} .node{fill:#00b83f}</style><rect data-audit-background="true" width="100%" height="100%" fill="#ffffff"/><path class="wire" d="M120 40 V220 M600 40 V220 M120 40 H600 M120 220 H600"/><circle class="src" cx="120" cy="130" r="32"/><text x="110" y="136">Vₛ</text><text x="114" y="114">+</text><text x="115" y="157">−</text><rect class="res" x="294" y="75" width="32" height="82" rx="5"/><text x="300" y="122">R1</text><rect class="res" x="474" y="75" width="32" height="82" rx="5"/><text x="480" y="122">R2</text><text x="245" y="248">Find each $P$, then verify $\sum P=0$.</text></svg>